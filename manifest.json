{
  "manifest_version": 3,
  "name": "Outlook Sticky Notes",
  "short_name": "Sticky Notes",
  "version": "1.0.0",
  "description": "Pin notes and action items to the top of any Outlook email thread. All notes are stored locally — nothing leaves your browser.",
  "homepage_url": "https://github.com/CoolpantsMcBadass/outlook-sticky-notes-ext",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://outlook.cloud.microsoft/*",
        "https://outlook.office.com/*",
        "https://outlook.live.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/postit.png"],
      "matches": ["https://outlook.cloud.microsoft/*", "https://outlook.office.com/*", "https://outlook.live.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
